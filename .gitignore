# 秘密情報。★ 絶対にコミットしない
.env
.env.local
*.env
!.env.example

# 録音（個人情報）
var/
recordings/
*.wav
*.mp3

# ビルド生成物
build/
.gradle/
target/
*.jar
# ★ Gradle wrapper の jar はコミットする。これが無いと ./gradlew が動かず、
#   手元に Gradle が入っていない環境（CI・Docker ビルド）でビルドできない。
#
# ★ 先頭に **/ を付けること。スラッシュを含むパターンは .gitignore からの
#   相対で「そのパスちょうど」にしか効かないため、
#   !gradle/wrapper/... と書くとルート直下しか除外解除されず、
#   api/gradle/wrapper/... は *.jar に飲まれたまま無視される。
#   実際にこれで Railway のビルドが
#   「Unable to access jarfile .../gradle-wrapper.jar」で失敗した。
!**/gradle/wrapper/gradle-wrapper.jar
__pycache__/
*.pyc
*.egg-info/
.eggs/
.venv/
venv/
node_modules/
.next/
out/

# キャッシュ・レポート
.pytest_cache/
*.tsbuildinfo
.ruff_cache/
coverage/
htmlcov/
*.log

# 評価用の作業ディレクトリ
kaden-saas-workspace/
