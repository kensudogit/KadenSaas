{
  // ==========================================================================
  // 行番号の左に「実行 / デバッグ」のアイコンを出すための設定。
  //
  // ★ アイコンが描かれるのはグリフマージン（行番号のさらに左）。
  //   editor.glyphMargin を false にすると、構成が正しくても何も出ない。
  //
  // ★ テストの ▷ は「テストが検出できていること」が条件。
  //   pytest / vitest / JUnit の検出設定をここで有効にしている。
  // ==========================================================================

  "editor.glyphMargin": true,
  "editor.lineNumbers": "on",
  "editor.folding": true,

  // テストの行に ▷ を出す（テストエクスプローラのガター表示）
  "testing.gutterEnabled": true,
  "testing.defaultGutterClickAction": "debug",
  "testing.automaticallyOpenTestResults": "openOnTestFailure",

  // 実行中の行・ブレークポイント候補を見えるようにする
  "debug.showInlineBreakpointCandidates": true,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.inlineValues": "auto",
  "debug.toolBarLocation": "docked",
  "debug.openDebug": "openOnDebugBreak",
  "debug.internalConsoleOptions": "openOnFirstSessionStart",

  // ------------------------------------------------------------------ Java
  // main メソッドとテストメソッドの上に「Run | Debug」が出る
  "java.debug.settings.enableRunDebugCodeLens": true,
  "java.test.editor.enableShortcuts": true,
  "java.jdt.ls.java.home": "C:\\pleiades-2025-03\\java\\21",
  "java.import.gradle.java.home": "C:\\pleiades-2025-03\\java\\21",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,
  "java.compile.nullAnalysis.mode": "automatic",
  "gradle.nestedProjects": true,

  // ---------------------------------------------------------------- Python
  // ★ voice/.venv を見に行かせる。ここが外れると pytest が検出されず、
  //   テスト関数の行に ▷ が出ない
  "python.defaultInterpreterPath": "${workspaceFolder}/voice/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/voice",
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}/voice"],

  // ------------------------------------------------------------ TypeScript
  "vitest.enable": true,
  "typescript.tsdk": "web/node_modules/typescript/lib",

  // ----------------------------------------------------------------- 除外
  // 検索とファイル監視から外す。ここを放置すると検出が遅くなり、
  // ▷ が出るまでに時間がかかる
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/build/**": true,
    "**/.gradle/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/build": true,
    "**/.venv": true,
    "**/kaden-saas-workspace": true
  }
}
